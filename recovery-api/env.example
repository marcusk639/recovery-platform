# Firebase — service account for Admin SDK
# Option A (local dev): path to downloaded service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B (Cloud Run): leave unset — ADC handles auth automatically

# Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Shared secret validated against the X-Service-Key header on every callable
# (generate with: openssl rand -hex 32). In production this is the
# RECOVERY_PLATFORM_API_KEY Firebase secret; callers send its value as X-Service-Key.
RECOVERY_PLATFORM_API_KEY=

# Port (Cloud Run sets this automatically; 8080 is the default)
PORT=8080

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://detox-recovery.web.app
