#!/bin/bash
# Pre-commit gate: blocking secret scan, 300-line ratchet and test-tamper gate
# on staged changes.
# Installed by scripts/install-git-hooks.sh (copies into .git/hooks/). Edit this
# file, never the installed copy; scripts/session-check.sh warns when they drift.
set -uo pipefail
REPO_ROOT_GATE=$(git rev-parse --show-toplevel)

# core.quotePath=false: otherwise git C-quotes non-ASCII names, `git show ":$f"`
# finds nothing, and the file is silently skipped by every check below.
STAGED=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM)
# Deletions are excluded from STAGED (filter ACM) because sections 1 and 2 inspect
# file CONTENT, which a deletion has none of. But the test-tamper gate in section
# 2.5 must see deletions — a commit whose only change is `rm` on a test file would
# otherwise exit here before being checked. So gate the early exit on any staged
# change, not just content-bearing ones.
STAGED_ANY=$(git -c core.quotePath=false diff --cached --name-only)
[ -z "$STAGED_ANY" ] && exit 0

FAIL=0

# --- 1. Secret scan (BLOCKING) -------------------------------------------
# Firebase client config files (native plist/json and the two web apps' config
# modules, matched by exact path) carry public-by-design AIza keys; test files
# may contain known-bad fixtures (e.g. google-apikeys.test.ts regression test).
#
# whsec_/sk_test_/rk_live_ added 2026-09-28: a doc-vs-code audit found two live
# Stripe webhook signing secrets committed in regroup/scripts/stripe-product-values.md
# (commit 5b9fbd7) — a class this scan could not previously catch.
#
# That file is deliberately NOT allowlisted: any commit that touches it is
# blocked until the secrets are scrubbed, and the scrubbing commit itself passes
# (the scan reads staged content). The secrets stay in git history regardless;
# rotating them is what closes the exposure.
SECRET_PATTERNS='sk-or-v1-[A-Za-z0-9]{16,}|sk-ant-[A-Za-z0-9_-]{16,}|sk_live_[A-Za-z0-9]{16,}|sk_test_[A-Za-z0-9]{16,}|rk_live_[A-Za-z0-9]{16,}|whsec_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AIza[0-9A-Za-z_-]{35}'
ALLOWLIST='GoogleService-Info[^/]*\.plist$|google-services[^/]*\.json$|AndroidManifest\.xml$|\.test\.(ts|tsx|js)$|__tests__/|package-lock\.json$|\.env\.example$|env\.example$|^regroup/web/src/environments/environment(\.prod)?\.ts$|^homegroups/web/src/lib/firebase\.js$'

while IFS= read -r f; do
  echo "$f" | grep -qE "$ALLOWLIST" && continue
  MATCH=$(git show ":$f" 2>/dev/null | grep -nE "$SECRET_PATTERNS" | head -3)
  if [ -n "$MATCH" ]; then
    echo "✗ possible secret in $f:" >&2
    echo "$MATCH" | sed 's/^/    /' >&2
    FAIL=1
  fi
done <<< "$STAGED"

# --- 2. File-size ratchet ---------------------------------------------------
# NEW source files over 300 lines are blocked; pre-existing oversized files
# only warn when modified (the mobile apps carry legacy debt — don't freeze them).
MAX_LINES=300
SRC_RE='\.(ts|tsx|js|jsx)$'
EXCLUDE_RE='node_modules/|/public/|\.min\.js$|-es(5|2015)\.js$|/dist/|/build/|/\.next/|jest\.setup\.(js|ts)$|\.config\.(js|cjs|mjs|ts)$|\.eslintrc\.js$'

while IFS= read -r f; do
  echo "$f" | grep -qE "$SRC_RE" || continue
  echo "$f" | grep -qE "$EXCLUDE_RE" && continue
  LINES=$(git show ":$f" 2>/dev/null | wc -l | tr -d ' ')
  [ "$LINES" -le "$MAX_LINES" ] && continue
  if git -c core.quotePath=false diff --cached --name-only --diff-filter=A | grep -qxF "$f"; then
    echo "✗ new file $f is $LINES lines (limit $MAX_LINES) — split it before committing" >&2
    FAIL=1
  else
    echo "⚠ $f is $LINES lines (>$MAX_LINES); consider splitting while you're in it" >&2
  fi
done <<< "$STAGED"

# --- 2.5 Test-tamper gate (BLOCKING) ---------------------------------------
# Rejects staged changes that disable or hollow out the test suite: deleted test
# files, tests renamed to non-test paths, added .skip/.only/.todo markers,
# assert-true assertions, a net loss of test cases, and snapshot churn.
#
# This lives here, not in a Claude Code hook, because Stage 1 testing on
# 2026-09-30 (Claude Code 2.1.274) proved the FIRST tool call of a
# `claude -p --settings` run executes before --settings hooks activate — so an
# agent whose opening move is destructive is ungated in-process. A git hook runs
# outside the agent and cannot be raced. Applies to every author equally: if a
# test must legitimately change, make the change deliberately and say why in the
# commit message, or bypass with --no-verify. CI does not re-run this gate, so a
# bypass is final; reviewers are the only remaining check.
#
# Degrades gracefully: if the gate script is absent (e.g. committing on a branch
# that predates .claude/agent-gates/), warn instead of blocking.
GATE="$REPO_ROOT_GATE/.claude/agent-gates/verify-diff.sh"
if [ -x "$GATE" ]; then
  if ! "$GATE" --staged; then
    FAIL=1
  fi
else
  echo "⚠ agent-gates/verify-diff.sh not found or not executable — test-tamper gate skipped" >&2
fi

if [ "$FAIL" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit blocked. Fix the issues above, or bypass deliberately with: git commit --no-verify" >&2
  exit 1
fi

# --- 3. Optional machine-local additions ------------------------------------
# Put machine-specific tooling in .git/hooks/pre-commit.local (untracked) rather
# than appending to the installed hook, which makes .git/hooks/pre-commit drift
# from this file and silently strands the appended code after `exit 0`.
# Never allowed to block a commit.
HOOK_DIR=$(dirname "$0")
if [ -x "$HOOK_DIR/pre-commit.local" ]; then
  "$HOOK_DIR/pre-commit.local" || true
fi

exit 0
