#!/bin/bash
# Pre-push gate: run unit tests for changed packages, with SHA-based caching.
# Installed by scripts/install-git-hooks.sh (copies into .git/hooks/).
#
# Git passes one line per pushed ref on stdin: <local ref> <local sha>
# <remote ref> <remote sha>. Changed files come from those refs, not from the
# checked-out branch, so a branch deletion tests nothing and pushing another
# branch never tests this one's changes.
set -uo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
# Per-worktree git dir: in a linked worktree `.git` is a file.
CACHE_FILE=$(cd "$REPO_ROOT" && cd "$(dirname "$(git rev-parse --git-path .test-passed)")" && pwd)/.test-passed
HEAD_SHA=$(git rev-parse HEAD)

# Packages with healthy, fast unit suites. Mobile apps and regroup/web are
# excluded (slow / CI-covered / legacy) — CI remains their gate.
PACKAGES="recovery-api detox-recovery homegroups/functions regroup/functions"

is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

CHANGED=""
TEST_HEAD=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "${LOCAL_SHA:-}" ] && continue
  is_zero "$LOCAL_SHA" && continue # deletion: nothing to test
  # Tests run against the working tree, so they only say something about the
  # pushed commit when it is the checked-out one. Other refs are left to CI.
  if [ "$LOCAL_SHA" != "$HEAD_SHA" ]; then
    echo "[pre-push] ⚠ $LOCAL_REF is not the checked-out commit; its tests are left to CI" >&2
    continue
  fi
  if ! is_zero "$REMOTE_SHA" && git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null; then
    FILES=$(git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA")
  else
    # New remote branch (or remote tip unknown locally): commits not on any remote.
    FILES=$(git log --format= --name-only "$LOCAL_SHA" --not --remotes)
  fi
  CHANGED="$CHANGED"$'\n'"$FILES"
  TEST_HEAD=1
done

if [ "$TEST_HEAD" -eq 0 ]; then
  echo "[pre-push] nothing to test (deletions only, or no ref at the checked-out commit)"
  exit 0
fi

if [ -f "$CACHE_FILE" ] && [ "$(cat "$CACHE_FILE")" = "$HEAD_SHA" ]; then
  echo "[pre-push] tests already passed for $HEAD_SHA — skipping"
  exit 0
fi

RAN=0
for PKG in $PACKAGES; do
  echo "$CHANGED" | grep -q "^$PKG/" || continue
  if [ ! -d "$REPO_ROOT/$PKG/node_modules" ]; then
    echo "[pre-push] ⚠ $PKG changed but node_modules missing — run 'npm ci' there; skipping its tests" >&2
    continue
  fi
  echo "[pre-push] running tests in $PKG..."
  if ! (cd "$REPO_ROOT/$PKG" && npm test --silent); then
    echo "[pre-push] ✗ tests failed in $PKG — push blocked (bypass: git push --no-verify)" >&2
    exit 1
  fi
  RAN=1
done

[ "$RAN" -eq 1 ] && echo "$HEAD_SHA" > "$CACHE_FILE"
exit 0
