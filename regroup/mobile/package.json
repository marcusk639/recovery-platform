{
  "name": "rats",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --appId com.regroup.app",
    "ios": "npx react-native run-ios --simulator=\"iPhone 14 Pro\"",
    "lint": "eslint .",
    "start": "react-native start",
    "start:android": "react-native start && adb shell am start -n com.regroup.app/com.rats.dev.MainActivity",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "test:e2e:run": "./e2e/run-tests.sh",
    "test:e2e:run:ios": "./e2e/run-tests.sh --platform ios",
    "test:e2e:run:android": "./e2e/run-tests.sh --platform android",
    "test:integration": "jest --config jest.config.integration.js --no-coverage",
    "test:rules": "jest --config jest.config.rules.js --no-coverage --forceExit",
    "test:e2e:dispute": "./e2e/run-tests.sh --suite dispute --platform ios",
    "test:e2e:verification": "./e2e/run-tests.sh --suite verification --platform ios",
    "test:e2e:auth": "./e2e/run-tests.sh --suite auth --platform ios",
    "test:e2e:phase5": "./e2e/run-phase-5-tests.sh",
    "test:e2e:phase5:no-build": "./e2e/run-phase-5-tests.sh --no-build",
    "seed-e2e": "node e2e/setup/seedTestData.js",
    "maestro:seed": "./maestro/scripts/reset-and-seed.sh",
    "maestro:ios": "maestro test -e APP_ID=com.rats.dev maestro/flows/",
    "maestro:android": "maestro test -e APP_ID=com.regroup.app maestro/flows/",
    "maestro:smoke:ios": "maestro test -e APP_ID=com.rats.dev maestro/flows/smoke.yaml",
    "maestro:smoke:android": "maestro test -e APP_ID=com.regroup.app maestro/flows/smoke.yaml",
    "maestro:suite:ios": "maestro test -e APP_ID=com.rats.dev maestro/flows/run-all.yaml",
    "maestro:suite:full": "maestro test -e APP_ID=com.rats.dev maestro/flows/run-all.yaml",
    "uninstall": "rm -rf node_modules",
    "pod:install": "cd ios && pod install && cd ..",
    "fresh-install": "rm -rf $TMPDIR/react-* && watchman watch-del-all && rm -rf ios/build/ModuleCache/* && rm -rf node_modules/ && npm cache clean --force && npm install",
    "postinstall": "patch-package && react-native setup-ios-permissions && pod-install"
  },
  "dependencies": {
    "@callstack/react-theme-provider": "^3.0.8",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@notifee/react-native": "^7.8.2",
    "@react-native-clipboard/clipboard": "^1.10.0",
    "@react-native-community/checkbox": "^0.5.20",
    "@react-native-community/cli-platform-ios": "^11.3.2",
    "@react-native-community/cli-plugin-metro": "^10.2.0",
    "@react-native-community/datetimepicker": "7.6.2",
    "@react-native-community/geolocation": "^3.0.5",
    "@react-native-community/push-notification-ios": "^1.10.1",
    "@react-native-community/toolbar-android": "^0.2.1",
    "@react-native-community/viewpager": "^5.0.11",
    "@react-native-firebase/analytics": "^17.3.1",
    "@react-native-firebase/app": "^17.3.1",
    "@react-native-firebase/auth": "^17.3.1",
    "@react-native-firebase/crashlytics": "^17.3.1",
    "@react-native-firebase/firestore": "^17.3.1",
    "@react-native-firebase/functions": "^17.3.1",
    "@react-native-firebase/messaging": "^17.3.1",
    "@react-native-firebase/storage": "^17.3.1",
    "@react-native-masked-view/masked-view": "^0.2.9",
    "@react-native-picker/picker": "^2.4.8",
    "@react-navigation/bottom-tabs": "^7.2.1",
    "@react-navigation/native": "^7.0.15",
    "@react-navigation/native-stack": "^7.2.1",
    "@react-navigation/stack": "^7.1.2",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react-native": "^7.12.0",
    "@stripe/stripe-react-native": "^0.67.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/react-native-push-notification": "^8.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "formik": "^2.2.9",
    "i18next": "^22.4.10",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.41",
    "ngeohash": "^0.6.3",
    "react": "18.2.0",
    "react-i18next": "^12.2.0",
    "react-native": "^0.72.0",
    "react-native-best-viewpager": "git+https://git@github.com/marcusk639/react-native-best-viewpager.git#view-pager-ref-fix",
    "react-native-collapsible": "^1.6.0",
    "react-native-date-picker": "^4.3.3",
    "react-native-document-picker": "^9.3.1",
    "react-native-floating-action": "^1.22.0",
    "react-native-fs": "^2.20.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "2.9.0",
    "react-native-google-places-autocomplete": "^2.5.1",
    "react-native-html-to-pdf": "^1.3.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keyboard-manager": "^6.5.4-5",
    "react-native-keyboard-spacer": "^0.4.1",
    "react-native-modal": "^13.0.0",
    "react-native-modal-datetime-picker": "18.0.0",
    "react-native-permissions": "^3.8.0",
    "react-native-picker-select": "^8.1.0",
    "react-native-popover-view": "^5.1.8",
    "react-native-push-notification": "^8.1.1",
    "react-native-safe-area-context": "4.5.0",
    "react-native-screens": "4.0.0",
    "react-native-simple-radio-button": "^2.7.4",
    "react-native-size-matters": "^0.4.0",
    "react-native-svg": "^13.14.0",
    "react-native-vector-icons": "^9.2.0",
    "react-native-webview": "^13.2.2",
    "react-navigation-redux-helpers": "^4.0.1",
    "react-redux": "^8.0.5",
    "redux": "^4.2.1",
    "redux-devtools-extension": "^2.13.9",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.4.2",
    "uuid": "^9.0.0",
    "victory-native": "^36.6.8",
    "yup": "^1.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.73.18",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.2.1",
    "@types/lodash": "^4.14.191",
    "@types/metro-config": "^0.76.3",
    "@types/react": "^18.0.24",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^9.0.1",
    "babel-jest": "^29.2.1",
    "detox": "^20.47.0",
    "detox-cli": "^20.47.0",
    "detox-mcp": "github:gayancliyanage/detox-mcp",
    "eslint": "^8.19.0",
    "firebase-admin": "^13.6.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.5",
    "patch-package": "^8.0.1",
    "pod-install": "0.1.38",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "sendgrid": "^5.2.3",
    "typescript": "5.0.2"
  },
  "reactNativePermissionsIOS": [
    "Camera",
    "LocationAccuracy",
    "LocationAlways",
    "LocationWhenInUse",
    "Motion",
    "Notifications",
    "PhotoLibrary",
    "PhotoLibraryAddOnly"
  ],
  "overrides": {
    "react-native-router-flux": {
      "react-native-reanimated": "2.17.0"
    },
    "react-native-picker-select": {
      "@react-native-picker/picker": "$@react-native-picker/picker"
    }
  },
  "engines": {
    "node": ">=16"
  }
}
