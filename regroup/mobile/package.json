{
  "name": "rats",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --appId com.regroup.app",
    "check:env": "node scripts/check-release-env.js",
    "check:env:release": "node scripts/check-release-env.js --release",
    "deploy:rules": "cd firebase && firebase deploy --only firestore:rules,storage --project phoenix-cleanhouse",
    "deploy:rules:dry": "cd firebase && firebase deploy --only firestore:rules,storage --project phoenix-cleanhouse --dry-run",
    "deploy:indexes": "cd firebase && firebase deploy --only firestore:indexes --project phoenix-cleanhouse",
    "fresh-install": "rm -rf $TMPDIR/react-* && watchman watch-del-all && rm -rf ios/build/ModuleCache/* && rm -rf node_modules/ && npm cache clean --force && npm install",
    "ios": "npx react-native run-ios --simulator=\"iPhone 14 Pro\"",
    "lint": "eslint .",
    "maestro:android": ": \"${E2E_TEST_PASSWORD:?Set E2E_TEST_PASSWORD (see e2e/SECURITY-test-credentials.md)}\" && maestro test -e E2E_TEST_PASSWORD=\"$E2E_TEST_PASSWORD\" -e APP_ID=com.regroup.app maestro/flows/",
    "maestro:ios": ": \"${E2E_TEST_PASSWORD:?Set E2E_TEST_PASSWORD (see e2e/SECURITY-test-credentials.md)}\" && maestro test -e E2E_TEST_PASSWORD=\"$E2E_TEST_PASSWORD\" -e APP_ID=com.rats.dev maestro/flows/",
    "maestro:seed": "./maestro/scripts/reset-and-seed.sh",
    "maestro:smoke:android": ": \"${E2E_TEST_PASSWORD:?Set E2E_TEST_PASSWORD (see e2e/SECURITY-test-credentials.md)}\" && maestro test -e E2E_TEST_PASSWORD=\"$E2E_TEST_PASSWORD\" -e APP_ID=com.regroup.app maestro/flows/smoke.yaml",
    "maestro:smoke:ios": ": \"${E2E_TEST_PASSWORD:?Set E2E_TEST_PASSWORD (see e2e/SECURITY-test-credentials.md)}\" && maestro test -e E2E_TEST_PASSWORD=\"$E2E_TEST_PASSWORD\" -e APP_ID=com.rats.dev maestro/flows/smoke.yaml",
    "maestro:suite:full": ": \"${E2E_TEST_PASSWORD:?Set E2E_TEST_PASSWORD (see e2e/SECURITY-test-credentials.md)}\" && maestro test -e E2E_TEST_PASSWORD=\"$E2E_TEST_PASSWORD\" -e APP_ID=com.rats.dev maestro/flows/run-all.yaml",
    "maestro:suite:ios": ": \"${E2E_TEST_PASSWORD:?Set E2E_TEST_PASSWORD (see e2e/SECURITY-test-credentials.md)}\" && maestro test -e E2E_TEST_PASSWORD=\"$E2E_TEST_PASSWORD\" -e APP_ID=com.rats.dev maestro/flows/run-all.yaml",
    "pod:install": "cd ios && pod install && cd ..",
    "postinstall": "patch-package && pod-install",
    "seed-e2e": "node e2e/setup/seedTestData.js",
    "start": "react-native start",
    "start:android": "react-native start && adb shell am start -n com.regroup.app/com.rats.dev.MainActivity",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.config.integration.js --no-coverage",
    "test:rules": "jest --config jest.config.rules.js --no-coverage --forceExit",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.js",
    "uninstall": "rm -rf node_modules"
  },
  "dependencies": {
    "@callstack/react-theme-provider": "^3.0.8",
    "@dr.pogodin/react-native-fs": "2.41.0",
    "@notifee/react-native": "^7.8.2",
    "@react-native-clipboard/clipboard": "^1.10.0",
    "@react-native-community/datetimepicker": "9.2.2",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-community/push-notification-ios": "^1.10.1",
    "@react-native-documents/picker": "12.0.3",
    "@react-native-firebase/analytics": "26.4.1",
    "@react-native-firebase/app": "26.4.1",
    "@react-native-firebase/auth": "26.4.1",
    "@react-native-firebase/firestore": "26.4.1",
    "@react-native-firebase/functions": "26.4.1",
    "@react-native-firebase/messaging": "26.4.1",
    "@react-native-firebase/storage": "26.4.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/fontawesome5": "14.0.0",
    "@react-native-vector-icons/ionicons": "14.0.0",
    "@react-native-vector-icons/material-icons": "14.0.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@reduxjs/toolkit": "2.13.0",
    "@sentry/react-native": "8.33.0",
    "@stripe/stripe-react-native": "0.84.0",
    "@tanstack/react-query": "5.105.0",
    "@types/react-native-push-notification": "^8.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "formik": "^2.2.9",
    "i18next": "26.5.11",
    "lodash": "^4.17.21",
    "ngeohash": "^0.6.3",
    "react": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-collapsible": "^1.6.0",
    "react-native-date-picker": "5.0.13",
    "react-native-gesture-handler": "3.4.0",
    "react-native-google-places-autocomplete": "2.6.5",
    "react-native-html-to-pdf": "1.3.0",
    "react-native-image-picker": "8.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keyboard-manager": "^6.5.4-5",
    "react-native-launch-arguments": "4.1.1",
    "react-native-modal": "13.0.2",
    "react-native-permissions": "5.6.3",
    "react-native-picker-select": "9.3.1",
    "react-native-popover-view": "6.1.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1",
    "react-native-simple-radio-button": "^2.7.4",
    "react-native-size-matters": "^0.4.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-redux": "9.3.1",
    "redux": "5.0.1",
    "uuid": "^9.0.0",
    "victory-native": "37.3.7",
    "yup": "^1.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.14.191",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^9.0.1",
    "babel-jest": "^29.2.1",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "dotenv": "^18.0.5",
    "eslint": "^8.19.0",
    "firebase": "12.17.1",
    "firebase-admin": "^13.6.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "pod-install": "0.1.38",
    "prettier": "^2.4.1",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "react-native-picker-select": {
      "@react-native-picker/picker": "$@react-native-picker/picker"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
