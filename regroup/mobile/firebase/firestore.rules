rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth.uid != null;
    }
    
    function hasHouseRole() {
      return signedIn() && request.auth.token != null;
    }
    
    function roleExists(role) {
      return request.auth.token[role] != null;
    }
    
    // Currently unused (zero call sites in this file). Would need the same
    // isDemoScopedHouses([houseId]) treatment as isAdmin/isGuest below if
    // ever wired up.
    function isHouseAdmin(houseId) {
      return 'admin' in request.auth.token && houseId in request.auth.token.admin;
    }

    // Currently unused (zero call sites in this file). Would need the same
    // isDemoScopedHouses([houseId]) treatment as isAdmin/isGuest below if
    // ever wired up.
    function isHouseSuperAdmin(houseId) {
      return hasHouseRole() && houseId in request.auth.token.superAdmin
    }

    function isHouseGuest(houseId) {
      return hasHouseRole() && houseId in request.auth.token.guest && isDemoScopedHouses([houseId]);
    }
    
    function getRoleFromClaim(role) {
      return request.auth.token[role];
    }
    
    function hasAdminRoleInHouse(houseIds) {
      return signedIn() && 'admin' in request.auth.token && request.auth.token.admin.keys().hasAny(houseIds);
    }

    function hasSuperAdminRoleInHouse(houseIds) {
      return hasHouseRole() && 'superAdmin' in request.auth.token && request.auth.token.superAdmin.keys().hasAny(houseIds);
    }

    function hasGuestRoleInHouse(houseIds) {
      return hasHouseRole() && 'guest' in request.auth.token && request.auth.token.guest.keys().hasAny(houseIds);
    }
    
    function isGuest(houseIds) {
      return hasGuestRoleInHouse(houseIds) && isDemoScopedHouses(houseIds);
    }

    function isAdmin(houseIds) {
      return (hasAdminRoleInHouse(houseIds) || hasSuperAdminRoleInHouse(houseIds)) && isDemoScopedHouses(houseIds);
    }
    
    function isSameUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    
    function isGuestOrAdmin(houseIds) {
    	return isGuest(houseIds) || isAdmin(houseIds);
    }

    function houseOxfordActive(houseId) {
      let h = get(/databases/$(database)/documents/houses/$(houseId)).data;
      return h.oxfordEnabled == true &&
        (h.subscriptionStatus == 'active' || h.subscriptionStatus == 'trialing');
    }

    function isDemoAccount() {
      // 'email' in request.auth.token is required: Firestore Rules throws
      // (rather than returning null/undefined, unlike JS) when dot-accessing
      // an absent map key, so any token without an email claim (e.g.
      // phone-only auth) would otherwise error out of every house-role check.
      return signedIn() && 'email' in request.auth.token && request.auth.token.email == 'demo_user@appdemo.net';
    }

    // Defense-in-depth: whenever the caller is the public demo account, further
    // restrict house-role checks to houses explicitly flagged isDemoHouse: true,
    // regardless of what custom claims the account happens to hold. Non-demo
    // accounts are completely unaffected (short-circuits to true immediately).
    // Deliberately fails CLOSED (denies) if houseIds isn't exactly one house —
    // the demo account should never legitimately need multi-house scope; the
    // one real multi-house caller (admins/{adminId}'s houseIds field) is
    // intentionally denied to the demo account rather than partially matched.
    function isDemoScopedHouses(houseIds) {
      return !isDemoAccount() ||
        (houseIds.size() == 1 &&
         get(/databases/$(database)/documents/houses/$(houseIds[0])).data.isDemoHouse == true);
    }

  // match /{document=**} {
    //   allow read, write: if signedIn();
    // }
    match /contact/{contactId} {
      // Public contact form: anyone (incl. unauthenticated) can submit, but the
      // payload is size-bounded to limit spam / quota-drain / SendGrid cost
      // amplification. Submissions are triaged server-side (Admin SDK / console),
      // so all client reads/updates/deletes are denied.
      allow create: if request.resource.data.size() <= 12
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow read, update, delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      // House subscription records: admin of the relevant house only.
      // Cloud Functions use the Admin SDK and bypass these rules entirely.
      allow read: if isAdmin([resource.data.houseId]);
      allow create, update: if isAdmin([request.resource.data.houseId]);
      allow delete: if isAdmin([resource.data.houseId]);
    }

    match /beta-users/{docId} {
      // Beta allowlist (beta-users/users holds an admin-managed emails array).
      // No client write path exists today; reads/writes go through the Admin SDK
      // or console. Deny all client access to remove the unauthenticated-write
      // spam/quota-drain surface. If a public beta form is added later, route it
      // through a rate-limited Cloud Function.
      allow read, write: if false;
    }
    
    match /admins/{adminId} {
      allow read: if isAdmin(resource.data.houseIds) || isSameUser(adminId);
      // allow create: if isAdmin(request.resource.data.houseIds);
      allow create: if isAdmin(request.resource.data.houseIds);
      allow update: if isAdmin(request.resource.data.houseIds);
      allow delete: if isAdmin(request.resource.data.houseIds);
      // allow create: if signedIn();
    }
    
    match /guests/{guestId} {
      allow read: if isGuest([resource.data.houseId]) || isAdmin([resource.data.houseId]); // need to adjust house search to not query guests (data needs to be aggregated on the house documents)

      // Self-create (invite signup) may not set the Stripe payment fields, so a
      // resident cannot plant a co-resident's customer id on their own doc.
      // Admin create and update stay unrestricted (house admins can still set
      // them); account deletion checks Stripe ownership server-side.
      allow create: if (isSameUser(request.resource.data.userId) &&
                        !request.resource.data.keys().hasAny(['stripeCustomerId', 'defaultPaymentMethodId'])) ||
                       isAdmin([request.resource.data.houseId]);

      // Update has two distinct branches:
      //
      //  Admin branch — full write authority on any field within the house.
      //    The admin must hold BOTH the guest's current house and the house
      //    the write leaves it in. houseId decides which house's Stripe
      //    account receives the guest's autopay rent, so checking only the
      //    new houseId let an admin of any house re-home another operator's
      //    resident and collect their rent from the card already on file.
      //    An operator who admins both houses can still move a guest.
      //
      //  Self branch — guest editing their own profile is restricted to a
      //    whitelist of personal fields. Financial fields (rentOwed,
      //    choreFees), advancement fields (phase, step, status), privilege
      //    fields (isAdmin, roles), and intake/discharge fields all stay
      //    admin-only. The optimistic-lock counter `version` is allowed so
      //    `guestService.updateGuest`'s transaction can increment it on
      //    self-writes.
      //
      // See .full-review/02-security-performance.md [S1] for the threat model.
      allow update: if
        (isAdmin([resource.data.houseId]) && isAdmin([request.resource.data.houseId])) ||
        (isSameUser(request.resource.data.userId) &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.houseId == resource.data.houseId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'displayName', 'firstName', 'lastName',
           'email', 'avatar', 'phoneNumber',
           'sobrietyDate', 'drugOfChoice',
           'emergencyContactName', 'emergencyContactPhone', 'emergencyContactRelation',
           'autoPayEnabled',
           'version', 'updatedAt', 'updatedBy'
         ]));

      allow delete: if isSameUser(resource.data.userId) || isAdmin([resource.data.houseId]);
    }
    
    match /guest-reports/{reportId} {
      allow read, write: if isGuestOrAdmin([resource.data.houseId]);
    }
    
    match /guest-weeks/{weekId} {
      allow read, write: if isSameUser(resource.data.userId) || isAdmin([resource.data.houseId]);
    }
    
    match /bugs/{bugId} {
      // Bug reports carry free-text that may contain PII. Only the reporter can
      // access their own report; developers triage via the Admin SDK / console
      // (which bypasses these rules). reporter is pinned to the caller on create.
      allow create: if isSameUser(request.resource.data.reporter);
      allow read, update, delete: if isSameUser(resource.data.reporter);
    }
    
    match /houses/{houseId} {
      allow read: if isGuestOrAdmin([houseId]);
      // Houses are created only by the server-side createHouses callable.
      allow create: if false;
      // Delete is superAdmin-of-this-house only, so a plain admin cannot
      // destroy the operator's house. Deleted ids are tombstoned server-side
      // (houseTombstones) and createHouses refuses them. Demo scoping matches
      // isAdmin. Uses the houseId path segment: request.resource does not
      // exist on delete.
      allow delete: if hasSuperAdminRoleInHouse([houseId]) && isDemoScopedHouses([houseId]);
      // Hardened 2026-07-14: this used to let ANY admin (not just
      // superAdmin) write financial/ownership fields (stripeAccountId,
      // stripeStatus, monthlyRent, weeklyRent, adminIds, ownerId) — only
      // guests were held to the sensitive-field allowlist. That contradicted
      // the app's own permission model (src/context/rules.ts), which grants
      // regular admin only 'house:partial-edit' and reserves
      // 'house:full-edit' (the action gating these exact fields in
      // HouseSummary.tsx) for superAdmin alone. A regular admin could bypass
      // the UI-only restriction via a direct write. superAdmin can update
      // anything; regular admins and guests share the same sensitive-field
      // restriction.
      // isDemoScopedHouses gates the whole expression (rather than relying on
      // isGuest()'s internal gate alone) since this rule also calls the raw
      // hasSuperAdminRoleInHouse/hasAdminRoleInHouse helpers directly, which
      // do NOT include the demo-account house-scoping check on their own.
      // SERVER-OWNED FIELDS. subscriptionStatus and guestGraceEndsAt are read by
      // the server entitlement gate, the mobile operator gate and
      // houseOxfordActive() — a client able to write them could grant itself
      // access. This guard sits ABOVE the role branches on purpose: the
      // superAdmin branch skips the sensitive-field allowlist entirely, so
      // putting these in that list alone would leave the hole open for exactly
      // the role most able to exploit it. Written only via the Admin SDK, which
      // bypasses rules. stripeAccountApi records which Stripe Accounts API owns
      // stripeAccountId; every server read and close dispatches on it, so a
      // client flipping it would stop status syncing and break disconnect.
      // superAdminId is the operator's uid (set by createHouses); server
      // callables and triggers resolve the operator through it, so no client
      // may write it. superAdminIds is an authorization field like
      // adminIds/ownerId: only a superAdmin of the house may change it.
      // adminId is a legacy field, blocked defensively the same way.
      allow update: if isDemoScopedHouses([houseId]) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscriptionStatus', 'guestGraceEndsAt', 'stripeAccountApi', 'superAdminId']) &&
        (hasSuperAdminRoleInHouse([houseId]) ||
          (hasAdminRoleInHouse([houseId]) && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['stripeAccountId', 'stripeStatus', 'monthlyRent', 'weeklyRent', 'adminIds', 'ownerId', 'superAdminIds', 'adminId'])) ||
          // Residents (guest role, not admin) may write ONLY the fields their
          // own app flows write (audited for PR #141): complaints and issues
          // (Personal screen) and currentCapacity (sign-up createGuest).
          // Not rooms/phases: a resident could lower their own phase
          // thresholds, and the only resident path that wrote them (deleting
          // their own guest profile) is denied anyway (guest-archive create is
          // admin-only). Not house.disputes: the onActivityWritten Cloud
          // Function maintains it, and residents used to rewrite the whole map.
          (hasGuestRoleInHouse([houseId]) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['complaints', 'issues', 'currentCapacity'])));
      
      match /chat/{chatId} {
        allow read, write: if isGuest([houseId]) || isAdmin([houseId]);
      }

      // Oxford House: officer roster — read open to members; writes require active Oxford subscription
      match /officers/{officerId} {
        allow read: if isGuestOrAdmin([houseId]);
        allow create, update, delete: if isAdmin([houseId]) && houseOxfordActive(houseId);
      }

      // Oxford House: business meeting records — read open; writes require active Oxford subscription
      match /business-meetings/{meetingId} {
        allow read: if isGuestOrAdmin([houseId]);
        allow create, update: if isGuestOrAdmin([houseId]) && houseOxfordActive(houseId);
        allow delete: if isAdmin([houseId]);
      }

      // Oxford House: governance votes — read open; creates and casts require active Oxford subscription
      match /votes/{voteId} {
        allow read: if isGuestOrAdmin([houseId]);
        allow create: if isAdmin([houseId]) && houseOxfordActive(houseId);
        // Hardened 2026-07-07: this used to allow any guest/admin of the
        // house to update ANY field of ANY vote doc with no scoping, which
        // is how a modified client (or a raw Firestore write) could inflate
        // an anonymous tally, clear its own id out of voterIds to re-vote, or
        // edit another guest's individualVotes entry — the client-side
        // "already voted" check was real code, but was never a security
        // boundary. Vote casting now goes exclusively through the
        // castOxfordVote Cloud Function (Admin SDK, bypasses these rules),
        // which resolves the caller's guestId from their own auth uid.
        allow update: if false;
        allow delete: if false;
      }

      // Financial records — permanent audit trail, all members can read
      match /financial-records/{recordId} {
        allow read: if signedIn() && (
          isAdmin([houseId]) || isHouseGuest(houseId)
        );
        allow create: if signedIn() && isAdmin([houseId]);
        allow update: if signedIn() && isAdmin([houseId]);
        allow delete: if false;
      }

      // Payment methods: sensitive Stripe data — admin of house OR the guest themselves can read.
      // Uses get() to look up the parent guest's Auth UID since Firestore doc IDs may differ from Auth UIDs.
      // Client writes are denied; Cloud Functions use the Admin SDK (bypasses rules) for all writes.
      match /guests/{guestId}/paymentMethods/{pmId} {
        allow read: if isAdmin([houseId]) ||
          (isGuest([houseId]) && get(/databases/$(database)/documents/guests/$(guestId)).data.userId == request.auth.uid);
        allow write: if false;
      }

      // Resident applications: applicant creates own; admin reads + updates status
      match /applications/{appId} {
        allow create: if signedIn() && request.resource.data.applicantUid == request.auth.uid;
        allow read: if signedIn() && (resource.data.applicantUid == request.auth.uid || isAdmin([houseId]));
        allow update: if isAdmin([houseId]);
        allow delete: if false;
      }
    }
    
    // Payments: only admins can read all house payments; guests read their own.
    // Manual payment recording restricted to admins.
    // Cloud Functions handle Stripe-originated writes via Admin SDK.
    match /payments/{paymentId} {
      allow read: if isAdmin([resource.data.houseId]) ||
        (isGuest([resource.data.houseId]) && isSameUser(resource.data.guestUserId));
      allow create: if isAdmin([request.resource.data.houseId]);
      allow update, delete: if false; // Only Cloud Functions should modify payments
    }

    match /complaints/{complaintId} {
      // Confidential: only house admins and the named complainant may read a
      // complaint — not every resident of the house (which would expose
      // complaints filed about, or by, other residents and chill reporting).
      // Clients render complaints from the embedded house.complaints map, not by
      // querying this collection, so admin-scoped reads don't break the app.
      // Anonymous complaints (plaintiff == '') are admin-only by construction.
      allow read: if isAdmin([resource.data.houseId])
        || isSameUser(resource.data.plaintiff);
      // Guests may only file complaints attributed to themselves; admins may
      // file on behalf of any plaintiff (including anonymous, plaintiff == '').
      allow create: if isAdmin([request.resource.data.houseId])
        || (isGuest([request.resource.data.houseId]) && request.resource.data.plaintiff == request.auth.uid);
      // houseId is immutable on update; membership is checked against the
      // existing house so a complaint can't be re-parented into another house.
      allow update: if isGuestOrAdmin([resource.data.houseId])
        && request.resource.data.houseId == resource.data.houseId;
      allow delete: if isAdmin([resource.data.houseId]);
    }
    
    match /issues/{issueId} {
      allow create: if isGuest([request.resource.data.houseId]) || isAdmin([request.resource.data.houseId]);
      // houseId is immutable on update; membership is checked against the
      // existing house so an issue can't be re-parented into another house.
      allow update: if (isGuest([resource.data.houseId]) || isAdmin([resource.data.houseId]))
        && request.resource.data.houseId == resource.data.houseId;
      allow read: if isGuest([resource.data.houseId]) || isAdmin([resource.data.houseId]);
      allow delete: if isAdmin([resource.data.houseId]);
    }
    
    match /disputes/{disputeId} {
      // Only house admins and the disputing resident may read a dispute — not
      // every resident of the house. Clients render disputes from the embedded
      // house map / activities collection, not by querying this collection, so
      // admin-scoped reads don't break the app.
      allow read: if isAdmin([resource.data.houseId])
        || isSameUser(resource.data.guestId);
      // Guests may only file disputes for themselves (guestId == Auth UID);
      // admins may file on behalf of any resident.
      allow create: if isAdmin([request.resource.data.houseId])
        || (isGuest([request.resource.data.houseId]) && request.resource.data.guestId == request.auth.uid);
      // houseId is immutable on update; membership is checked against the
      // existing house so a dispute can't be re-parented into another house.
      allow update: if isGuestOrAdmin([resource.data.houseId])
        && request.resource.data.houseId == resource.data.houseId;
      allow delete: if isAdmin([resource.data.houseId]);
    }
    
    match /users/{userId} {
      allow read: if isSameUser(userId);

      // subscriptionMetadata is SERVER-OWNED. Both the server entitlement gate
      // (functions/src/util/entitlement.ts) and the house-create trigger
      // (setHouseSubscriptionStatusOnCreate) derive access from
      // subscriptionMetadata.status, so a client able to write it could grant
      // itself access — and the server-side stamp would be forgeable too. The
      // Admin SDK bypasses rules, so legitimate server writes are unaffected.
      //
      // On create the client writes the whole User entity, whose default status
      // is "", so that is permitted; anything already claiming a real status is
      // not. The houses map is trusted as an ownership/cap record, so a client
      // may not seed it: it must be absent or empty. The Stripe ids must be
      // absent or empty too: the owner can delete and recreate this doc, and
      // account deletion reads them (the server still checks Stripe ownership).
      allow create: if isSameUser(userId) &&
        (!('subscriptionMetadata' in request.resource.data) ||
          ((!('status' in request.resource.data.subscriptionMetadata) ||
              request.resource.data.subscriptionMetadata.status == '') &&
            (!('customerId' in request.resource.data.subscriptionMetadata) ||
              request.resource.data.subscriptionMetadata.customerId == '') &&
            (!('subscriptionId' in request.resource.data.subscriptionMetadata) ||
              request.resource.data.subscriptionMetadata.subscriptionId == '') &&
            (!('houses' in request.resource.data.subscriptionMetadata) ||
              (request.resource.data.subscriptionMetadata.houses is map &&
                request.resource.data.subscriptionMetadata.houses.size() == 0))));

      // affectedKeys() reports only keys whose value actually changed, so a
      // whole-object write that echoes the same metadata back still passes.
      allow update: if isSameUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscriptionMetadata']);

      // No client deletes. The doc holds the server-written subscriptionMetadata
      // (houses map = property-cap count, Stripe ids); a delete-and-recreate
      // would reset it, letting an operator at the cap subscribe again with an
      // empty map. Account deletion runs server-side (deleteAccount callable).
      allow delete: if false;
    }
    
    match /notifications/{notificationId} {
      // Users can only read/write their own notifications.
      allow read, write: if isSameUser(resource.data.userId);
      allow create: if isSameUser(request.resource.data.userId);
    }
    
    match /feedback/{feedbackId} {
      // Feedback carries free-text that may contain PII. The submitter (reviewer)
      // can access their own; house admins can access house-scoped feedback.
      // App-level feedback (houseId == '') is submitter-only since no one is an
      // admin of ''. reviewer is pinned to the caller on create.
      allow create: if isSameUser(request.resource.data.reviewer);
      allow read: if isSameUser(resource.data.reviewer) || isAdmin([resource.data.houseId]);
      allow update: if isSameUser(resource.data.reviewer) || isAdmin([resource.data.houseId]);
      allow delete: if isSameUser(resource.data.reviewer) || isAdmin([resource.data.houseId]);
    }
    
    match /meetings/{meetingId} {
      // Guests can read and log attendance; only admins can delete.
      allow read: if isGuestOrAdmin([resource.data.houseId]);
      allow create, update: if isGuestOrAdmin([request.resource.data.houseId]);
      allow delete: if isAdmin([resource.data.houseId]);
    }
    
    match /guest-archive/{guestId} {
      // Archived discharge + financial records: residents may read, but only
      // house admins may create/update/delete (prevents residents overwriting
      // their own discharge/financial history).
      allow read: if isGuestOrAdmin([resource.data.houseId]);
      allow create, update: if isAdmin([request.resource.data.houseId]);
      allow delete: if isAdmin([resource.data.houseId]);
    }

    // The guest doc an activity claims to be for (guest doc ids are not auth
    // uids; guests.userId is the resident's uid).
    function activityGuest(guestId) {
      return get(/databases/$(database)/documents/guests/$(guestId)).data;
    }

    // Every dispute field. Clients change them only through the transitions
    // below (enter, resolve, reopen). residentUid is server-only: the
    // onActivityWritten Cloud Function stamps it from guests.userId.
    function disputeKeys() {
      return ['disputeReason', 'disputedBy', 'disputeResolvedBy', 'disputeResolvedAt', 'disputed',
              'incomplete', 'disputeOutcome', 'disputeResult', 'disputedAt', 'reopenedBy', 'reopenedAt'];
    }

    // Owner rule: an activity is never disputed, resolved or reopened by the
    // person who did it: whoever logged it (loggedBy), the resident the server
    // stamped on it (residentUid, from guests.userId; re-stamped whenever the
    // guest's account changes), and the account on its guest doc now. The
    // guest doc alone can be edited or deleted around a dispute, so the stamp
    // is what holds. A null stamp (a guest with no account when stamped) is no
    // stamp: with neither a usable stamp nor a guest doc, only the house owner
    // (superAdmin) may act.
    function callerIsNotTheResident() {
      let d = resource.data;
      let gid = d.get('guestId', '');
      let stamp = d.get('residentUid', null);
      let stamped = stamp is string && stamp != '';
      return request.auth.uid != d.get('loggedBy', null) &&
        (!stamped || stamp != request.auth.uid) &&
        ((gid is string && gid != '' && exists(/databases/$(database)/documents/guests/$(gid)))
          ? get(/databases/$(database)/documents/guests/$(gid)).data.get('userId', null) != request.auth.uid
          : (stamped || (hasSuperAdminRoleInHouse([d.houseId]) && isDemoScopedHouses([d.houseId]))));
    }

    // Owner rule: "Disputed activities should never be deleted." Any dispute
    // history at all: an open or decided dispute, or any dispute field ever
    // recorded (an old build's dispute set disputeResolvedBy only). Such an
    // activity is never deleted (soft or hard), by anyone.
    function hasDisputeHistory(d) {
      return d.status == 'disputed' || d.status == 'resolved' ||
        d.keys().hasAny(['disputeReason', 'disputedBy', 'disputeResolvedBy', 'disputeResolvedAt',
                         'disputed', 'disputeOutcome', 'disputedAt', 'reopenedBy']) ||
        d.get('disputeResult', 'none') != 'none' ||
        d.get('incomplete', false) == true;
    }

    // Dispute history is never erased: a dispute field, once set, is never
    // removed or nulled. ENTER, RESOLVE and the other admin writes each
    // limit which fields they touch, so this is checked where it can happen.
    // (Only a REOPEN clears the decision; see reopensDecision.)
    function keeps(k) {
      return resource.data.get(k, null) == null || request.resource.data.get(k, null) != null;
    }

    // ENTER (peer or admin): only an ACTIVE activity, and the write names the
    // caller as the disputer in BOTH fields: disputeResolvedBy (old builds
    // set only this) and disputedBy if present. disputedAt, if written, is
    // the server time: it tells this dispute apart from an earlier one on the
    // same activity. The onActivityWritten Cloud Function takes the disputer
    // from these fields (disputerOf), so they must be trustworthy.
    function entersDispute() {
      let d = request.resource.data;
      return resource.data.status == 'active' && d.status == 'disputed' &&
        d.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'disputeReason', 'disputedBy', 'disputeResolvedBy', 'disputedAt', 'loggedAt']) &&
        // loggedAt is not the disputer's to rewrite; older builds stamp it
        // with the server time, which stays allowed.
        (!d.diff(resource.data).affectedKeys().hasAny(['loggedAt']) || d.loggedAt == request.time) &&
        // This write names the disputer (a leftover from an earlier dispute does not).
        d.diff(resource.data).affectedKeys().hasAny(['disputedBy', 'disputeResolvedBy']) &&
        d.get('disputeResolvedBy', null) == request.auth.uid &&
        d.get('disputedBy', request.auth.uid) == request.auth.uid &&
        d.get('disputedAt', request.time) == request.time &&
        keeps('disputeReason') && keeps('disputedBy') && keeps('disputedAt') &&
        callerIsNotTheResident();
    }

    // A decision is one of three, consistently:
    //   APPROVE: disputed 'successful', incomplete true, disputeOutcome
    //            'incomplete-per-residents', disputeResult 'success' (not counted);
    //   REJECT:  disputed 'rejected', incomplete false, no disputeOutcome,
    //            disputeResult 'fail' (counted);
    //   KEEP:    an old build's "keep", no outcome fields (counted, like REJECT).
    function consistentOutcome() {
      let d = request.resource.data;
      return (d.get('disputed', null) == 'successful' && d.get('incomplete', null) == true &&
              d.get('disputeOutcome', null) == 'incomplete-per-residents' &&
              d.get('disputeResult', null) == 'success') ||
        (d.get('disputed', null) == 'rejected' && d.get('incomplete', null) == false &&
         d.get('disputeOutcome', null) == null && d.get('disputeResult', null) == 'fail') ||
        (d.get('disputed', null) == null && d.get('incomplete', null) in [null, false] &&
         d.get('disputeOutcome', null) == null && d.get('disputeResult', null) == null);
    }

    // RESOLVE (admin): an OPEN dispute only (so a second admin cannot
    // overwrite the first decision), to `resolved` with a consistent outcome,
    // recording the caller and the server time as resolver. The disputer
    // fields stay as they are.
    function resolvesDispute() {
      let d = request.resource.data;
      return resource.data.status == 'disputed' && d.status == 'resolved' &&
        d.get('disputeResolvedBy', null) == request.auth.uid &&
        d.get('disputeResolvedAt', null) == request.time &&
        !d.diff(resource.data).affectedKeys()
          .hasAny(['disputeReason', 'disputedBy', 'disputedAt', 'reopenedBy', 'reopenedAt',
                   'guestId', 'loggedBy', 'houseId', 'residentUid']) &&
        consistentOutcome() &&
        callerIsNotTheResident();
    }

    // An old build's "delete" resolution: deleted, resolved at loggedAt.
    function legacyUpheld(r) {
      return r.status == 'deleted' && r.get('disputeResolvedAt', null) != null &&
        r.get('disputeResolvedAt', null) == r.get('loggedAt', null) &&
        r.get('disputed', null) == null && r.get('incomplete', null) != true;
    }

    // REOPEN (admin, owner decision "add a way to undo dispute decisions"): a
    // decided dispute (or an old build's "delete") goes back to `disputed`,
    // pending and counted, to be decided again. The write records the caller
    // and server time (reopenedBy/At), clears the decision (the only write
    // that may), and changes nothing else. The decision it undoes must
    // already be in the server's decision log
    // (activities/{id}/dispute-decisions/decided_{disputeResolvedAt ms},
    // written with the /disputes archive), so no decision is ever lost.
    function reopensDecision(activityId) {
      let r = resource.data;
      let d = request.resource.data;
      let at = r.get('disputeResolvedAt', null);
      return (r.status == 'resolved' || legacyUpheld(r)) && d.status == 'disputed' &&
        d.diff(r).affectedKeys().hasOnly(['status', 'reopenedBy', 'reopenedAt', 'disputed', 'incomplete',
          'disputeResult', 'disputeOutcome', 'disputeResolvedBy', 'disputeResolvedAt']) &&
        d.get('reopenedBy', null) == request.auth.uid && d.get('reopenedAt', null) == request.time &&
        d.get('disputed', null) == null && d.get('incomplete', null) == null &&
        d.get('disputeResult', null) == null && d.get('disputeOutcome', null) == null &&
        d.get('disputeResolvedBy', null) == null && d.get('disputeResolvedAt', null) == null &&
        at is timestamp &&
        exists(/databases/$(database)/documents/activities/$(activityId)/dispute-decisions/$('decided_' + string(at.toMillis()))) &&
        callerIsNotTheResident();
    }

    // Every admin write but REOPEN, by transition: ENTER, RESOLVE, or a write
    // that touches no dispute field (and never residentUid). In the last,
    // who/where the activity is (guestId, loggedBy, houseId) is frozen once
    // there is dispute history, and status moves only active <-> deleted with
    // no dispute history: a pending dispute leaves only by RESOLVE, a
    // decision (or an old build's "delete") only by REOPEN.
    function adminUpdates() {
      let r = resource.data;
      let d = request.resource.data;
      let keys = d.diff(r).affectedKeys();
      return isAdmin([r.houseId]) &&
        (r.status != 'disputed' && d.status == 'disputed' ? entersDispute() :
         r.status == 'disputed' && d.status != 'disputed' ? resolvesDispute() :
         (!keys.hasAny(disputeKeys()) && !keys.hasAny(['residentUid', 'flaggedForReview']) &&
          (!keys.hasAny(['guestId', 'loggedBy', 'houseId', 'status']) ||
           (!hasDisputeHistory(r) &&
            (!keys.hasAny(['status']) ||
             (r.status in ['active', 'deleted'] && d.status in ['active', 'deleted'])))) &&
          (!keys.hasAny(['houseId']) || isAdmin([d.houseId]))));
    }

    match /activities/{activityId} {
      allow read: if isGuest([resource.data.houseId]) || isAdmin([resource.data.houseId]);
      // Activities feed week-summaries (phase compliance, computed server-side
      // by onActivityWritten) and the court compliance export, so who an
      // activity is for, which house, and its status are not the client's to
      // choose. The guest must exist and live in the activity's house. A house
      // admin may log for any of its residents; a resident only for
      // themselves, as an active, unverified activity. Nobody creates an
      // activity with dispute fields, residentUid, or already in a dispute.
      // Whoever creates it is its logger (loggedBy), admins too. Ids are
      // limited to the characters the server's dispute mirror can key on.
      allow create: if
        activityId.matches('^[A-Za-z0-9_-]+$') &&
        activityGuest(request.resource.data.guestId).houseId == request.resource.data.houseId &&
        !request.resource.data.keys().hasAny(['residentUid', 'flaggedForReview']) &&
        !request.resource.data.keys().hasAny(disputeKeys()) &&
        !(request.resource.data.get('status', null) in ['disputed', 'resolved']) &&
        ((isAdmin([request.resource.data.houseId]) && isSameUser(request.resource.data.loggedBy)) ||
          (isGuest([request.resource.data.houseId]) &&
           isSameUser(request.resource.data.loggedBy) &&
           activityGuest(request.resource.data.guestId).userId == request.auth.uid &&
           request.resource.data.status == 'active' &&
           request.resource.data.get('verified', false) == false));
      // `verified`/`verifiedBy` feed the Verified column of the court-ready
      // compliance export, so non-admins never edit details.
      //
      // - Admins (owners, managers, peer leaders): adminUpdates, plus REOPEN.
      // - The resident who logged it: soft-delete only (status + loggedAt),
      //   and only with no dispute history.
      // - A resident of the same house (peer): ENTER a dispute only, never on
      //   their own activity (owner rule).
      // ENTER, RESOLVE and REOPEN are never by the activity's resident or
      // whoever logged it (callerIsNotTheResident). diff() only flags real
      // changes, so a write echoing the current values back passes.
      allow update: if
        (request.resource.data.status == 'disputed' && resource.data.status in ['resolved', 'deleted'] &&
         isAdmin([resource.data.houseId]) ? reopensDecision(activityId) : adminUpdates()) ||
        (isSameUser(resource.data.loggedBy) &&
          request.resource.data.status == 'deleted' &&
          !hasDisputeHistory(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'loggedAt']) &&
          request.resource.data.get('loggedAt', null) in [resource.data.get('loggedAt', null), request.time]) ||
        (isGuest([resource.data.houseId]) && entersDispute());
      // Hard delete: admins only, and never an activity with dispute history.
      allow delete: if isAdmin([resource.data.houseId]) && !hasDisputeHistory(resource.data);

      // The append-only dispute decision log (approved | rejected | kept |
      // deleted | reopened), written only by the onActivityWritten Cloud
      // Function. REOPEN checks it with exists().
      match /dispute-decisions/{decisionId} {
        allow read, write: if false;
      }
    }

    // The authoritative list of a house's open disputes, written only by the
    // onActivityWritten Cloud Function. houses/{id}.disputes is kept as a
    // legacy, display-only mirror for older app builds; admins can still
    // rewrite it (house setup saves whole-house copies), so nothing trusts it.
    match /house-disputes/{houseId} {
      allow read: if isGuestOrAdmin([houseId]);
      allow write: if false;
    }

    function summaryGuest(summaryId) {
      return activityGuest(summaryId.split('_')[0]);
    }

    match /week-summaries/{summaryId} {
      // Written by the onActivityWritten Cloud Function (Admin SDK), some time
      // after the activity. The app subscribes to {guestId}_{weekStart} before
      // that, so a missing doc must read as not-found: dereferencing
      // resource.data on a null resource denied it and killed the listener.
      //
      // The missing-doc branch is scoped through the guest the id names
      // ({guestId}_{weekStart}; guest ids are auto-ids with no '_'): the same
      // house members who could read the summary once it exists. So a stranger
      // cannot probe whether a summary exists. Costs one get() per read of a
      // missing summary.
      allow read: if (resource == null && signedIn() &&
          (summaryGuest(summaryId).userId == request.auth.uid ||
           isGuest([summaryGuest(summaryId).houseId]) ||
           isAdmin([summaryGuest(summaryId).houseId]))) ||
        isGuest([resource.data.houseId]) || isAdmin([resource.data.houseId]);
      // The app no longer writes summaries. Admin write remains ONLY for app
      // versions released before the trigger, which still write them (+1 on
      // log, -1 on delete, a full client recompute on edit/resolve). The
      // trigger's next recompute overwrites those, but a write landing after
      // it persists until then, so the post-rollout backfill re-run is
      // mandatory. Change to `if false` once those versions are unsupported.
      allow write: if isAdmin([request.resource.data.houseId]);
    }
    
    match /direct-messages/{messageId}/chat/{chatId} {
      allow read: if isSameUser(resource.data.recipientId) || isSameUser(resource.data.senderId);
      allow create: if request.auth.uid == request.resource.data.senderId;
      allow update, delete: if isSameUser(resource.data.senderId);
    }

    match /webhookEvents/{eventId} {
      // Written exclusively by Cloud Functions via the Admin SDK. Deny all client access.
      allow read, write: if false;
    }

    match /invitations/{token} {
      // All access goes through createInvitation / peekInvitation /
      // redeemInvitation callables. The admin SDK bypasses rules, so
      // clients are denied entirely.
      allow read, write: if false;
    }

    // Oxford House: Equal Expense Share tracker — top-level collection, scoped by houseId field
    match /ees-records/{eesId} {
      allow read: if isGuestOrAdmin([resource.data.houseId]);
      allow create: if isAdmin([request.resource.data.houseId]);
      allow update: if isAdmin([resource.data.houseId]);
      allow delete: if isAdmin([resource.data.houseId]);
    }

    // Drug test records — immutable audit trail
    match /drug-tests/{testId} {
      allow read: if signedIn() && (
        isAdmin([resource.data.houseId]) ||
        isSameUser(resource.data.observedBy)
      );
      allow create: if signedIn() && isAdmin([request.resource.data.houseId]);
      allow update, delete: if false;
    }

    match /documents/{docId} {
      // Only house admins and super-admins can read or write documents.
      // Residents (guests) have zero access.
      allow read: if signedIn() && isAdmin([resource.data.houseId]);
      allow create: if signedIn() && isAdmin([request.resource.data.houseId]);
      allow delete: if signedIn() && isAdmin([resource.data.houseId]);
      allow update: if false;
    }
  }
}