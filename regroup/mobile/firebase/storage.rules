rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseAdmin(houseId) {
      return isAuthenticated()
        && (
          (request.auth.token.admin != null && houseId in request.auth.token.admin)
          || (request.auth.token.superAdmin != null && houseId in request.auth.token.superAdmin)
        );
    }

    function hasGuestClaim(houseId) {
      return isAuthenticated()
        && request.auth.token.guest != null
        && houseId in request.auth.token.guest;
    }

    // The shared App Review demo login (its password is in the app). It may read
    // what its claims allow, but never upload, overwrite or delete: every write
    // rule below starts with notDemo(). Mirrors isDemoAccount() in
    // firestore.rules and functions util/demoAccount.ts. 'email' in token is
    // checked first: reading an absent key is an error, which would deny every
    // write by an account without an email (phone sign-in).
    function notDemo() {
      return !(isAuthenticated()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'demo_user@appdemo.net');
    }

    function isHouseMember(houseId) {
      return isAuthenticated()
        && (
          (request.auth.token.guest != null && houseId in request.auth.token.guest)
          || isHouseAdmin(houseId)
        );
    }

    // Write helpers: allow delete (no request.resource) OR valid upload.
    // Firebase Storage `write` covers create, update, AND delete. Delete ops
    // have no request.resource so content-type/size checks must not apply.
    function isValidImageWrite(maxSizeBytes) {
      return (request.resource == null)
        || (request.resource.contentType.matches('image/.*')
            && request.resource.size <= maxSizeBytes);
    }

    function isValidPdfWrite(maxSizeBytes) {
      return (request.resource == null)
        || (request.resource.contentType == 'application/pdf'
            && request.resource.size <= maxSizeBytes);
    }

    function isValidSizedWrite(maxSizeBytes) {
      return (request.resource == null)
        || request.resource.size <= maxSizeBytes;
    }

    // =========================================================================
    // 1. User Avatars: users/{userId}/avatar
    //    Read:  only the owning user
    //    Write: only the owning user; images only; max 5 MB
    //
    // Read was isAuthenticated() until S5 (2026-11-27), so anyone who completed
    // free signup could fetch a user's face photo by uid. Nothing else reads it
    // through the SDK: the owner reads it once after upload to store its
    // download URL in users/{uid}.avatar, and everyone else shows that URL
    // (a download-token URL, which these rules do not govern).
    // =========================================================================
    match /users/{userId}/avatar {
      allow read: if isOwner(userId);
      allow write: if notDemo()
                   && isOwner(userId)
                   && isValidImageWrite(5 * 1024 * 1024);
    }

    // =========================================================================
    // 2. House Photos: houses/{houseId}/photo
    //    Read:  any authenticated user
    //    Write: admin/superAdmin of that house; images only; max 10 MB
    // =========================================================================
    match /houses/{houseId}/photo {
      allow read: if isAuthenticated();
      allow write: if notDemo()
                   && isHouseAdmin(houseId)
                   && isValidImageWrite(10 * 1024 * 1024);
    }

    // =========================================================================
    // 3. House Logos: houses/{houseId}/logo/{fileName}
    //    Read:  any authenticated user
    //    Write: admin/superAdmin of that house; images only; max 5 MB
    // =========================================================================
    match /houses/{houseId}/logo/{fileName} {
      allow read: if isAuthenticated();
      allow write: if notDemo()
                   && isHouseAdmin(houseId)
                   && isValidImageWrite(5 * 1024 * 1024);
    }

    // =========================================================================
    // 4. Guest Avatars: houses/{houseId}/guests/{guestId}/avatar/{fileName}
    //    Read:  members of that house (guests + admins)
    //    Write: admin/superAdmin of that house; images only; max 5 MB
    //
    // Read was `isAuthenticated()` until 2026-10-02, which let anyone who
    // completed free self-serve signup fetch any resident's face photo in any
    // house given a houseId/guestId pair — both are Firestore doc ids that
    // travel in exports, shared links and prior memberships. Residency in a
    // sober-living house implies recovery status, so that is the disclosure
    // this product exists to prevent. Chore photos directly below were already
    // member-scoped, so the open read was an inconsistency, not a design.
    // =========================================================================
    match /houses/{houseId}/guests/{guestId}/avatar/{fileName} {
      allow read: if isHouseMember(houseId);
      allow write: if notDemo()
                   && isHouseAdmin(houseId)
                   && isValidImageWrite(5 * 1024 * 1024);
    }

    // =========================================================================
    // 5. Chore Photos: houses/{houseId}/chore-evidence/{userId}/{fileName}
    //    Read:  house members (guests + admins of that house)
    //    Write: the resident themself: their own folder, and only while they
    //           hold the guest claim for that house; images only; max 10 MB
    //
    // The app uploads here before logging the chore (GuestChoreSummary,
    // services/storage.tsx uploadChoreEvidencePhoto). {userId} is the
    // resident's account, which the activity rules require as the chore
    // entry's residentUid, so a resident can neither write nor overwrite a
    // housemate's photo, and staff without the guest claim upload none.
    //
    // Until S5 the only chore rule was houses/{houseId}/{week}/{day}/chores/
    // {guestId}/{fileName}, writable by any member into any guestId folder,
    // and the app's path (houses/{houseId}/chore-evidence/{id}) matched no
    // rule, so every chore photo upload was refused. No client used the old
    // path; it now falls to the catch-all deny.
    // =========================================================================
    match /houses/{houseId}/chore-evidence/{userId}/{fileName} {
      allow read: if isHouseMember(houseId);
      allow write: if notDemo()
                   && isOwner(userId)
                   && hasGuestClaim(houseId)
                   && isValidImageWrite(10 * 1024 * 1024);
    }

    // =========================================================================
    // 6. PDF Reports: reports/{houseId}/{reportPath=**}
    //    Read:  house members (guests + admins)
    //    Write: admin/superAdmin only; PDFs only; max 20 MB
    // =========================================================================
    match /reports/{houseId}/{reportPath=**} {
      allow read: if isHouseMember(houseId);
      allow write: if notDemo()
                   && isHouseAdmin(houseId)
                   && isValidPdfWrite(20 * 1024 * 1024);
    }

    // =========================================================================
    // 7. Temporary Uploads: temp/{userId}/{tempPath=**}
    //    Read:  only the owning user
    //    Write: only the owning user; any content type; max 10 MB
    // =========================================================================
    match /temp/{userId}/{tempPath=**} {
      allow read: if isOwner(userId);
      allow write: if notDemo()
                   && isOwner(userId)
                   && isValidSizedWrite(10 * 1024 * 1024);
    }

    // =========================================================================
    // 8. Documents: houses/{houseId}/documents/{docId} and
    //    houses/{houseId}/guests/{guestId}/documents/{docId}
    //    Write (upload, delete): house admins only, as for the documents
    //    collection in firestore.rules. Residents have no access. PDFs and
    //    images only (the picker offers no others); max 25 MB.
    //    Read: nobody. Documents open through getDocumentLink's 15-minute signed
    //    link, which checks claims live. A client read would let any admin claim
    //    mint a download-token URL that bypasses the rules and keeps working
    //    after their access is removed.
    // =========================================================================
    function isValidDocumentWrite() {
      return (request.resource == null)
        || ((request.resource.contentType == 'application/pdf'
             || request.resource.contentType.matches('image/.*'))
            && request.resource.size <= 25 * 1024 * 1024);
    }

    match /houses/{houseId}/documents/{docId} {
      allow read: if false;
      allow write: if notDemo() && isHouseAdmin(houseId) && isValidDocumentWrite();
    }

    match /houses/{houseId}/guests/{guestId}/documents/{docId} {
      allow read: if false;
      allow write: if notDemo() && isHouseAdmin(houseId) && isValidDocumentWrite();
    }

    // =========================================================================
    // CATCH-ALL DENY
    // Any path not matched above is denied. Firebase denies by default but
    // we make it explicit for auditability.
    // =========================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
