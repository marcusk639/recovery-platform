def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# RNFirebase: static frameworks (use_frameworks! below) and the CocoaPods
# Firebase SDK rather than Swift Package Manager.
$RNFirebaseAsStaticFramework = true
$RNFirebaseDisableSPM = true
# Stripe RN 0.83.0 with the stripe-ios CocoaPods pods: its SPM path (the only
# one in 0.84.0) requires dynamic frameworks, which RNFirebase 26's static
# linkage rules out (docs/build/react-native-0.88-upgrade.md, Task 13).
$StripeDisableSPM = true

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions 5: the iOS permission handlers the app uses (they
# were `reactNativePermissionsIOS` in package.json on 3.x).
setup_permissions([
  'Camera',
  'LocationAccuracy',
  'LocationAlways',
  'LocationWhenInUse',
  'Motion',
  'Notifications',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
])

# The e2e configurations are Release builds of the app (bundled JS, no Metro)
# for other Firebase projects; see scripts/ios-configure-e2e-bundle.sh.
project 'rats', 'E2EEmulator' => :release, 'E2EStaging' => :release

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => :static
end

target 'rats' do
  config = use_native_modules!
  use_frameworks! :linkage => :static

  # Hermes is the JS engine (RN 0.81 removed the built-in JSC) and the New
  # Architecture is always on (RN 0.82+), so neither is configured here.
  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'ratsTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      if target.name == 'BoringSSL-GRPC'
        target.source_build_phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            flags = file.settings['COMPILER_FLAGS'].split
            flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
            file.settings['COMPILER_FLAGS'] = flags.join(' ')
          end
        end
      end
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.0'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings["CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES"] = true

        # Fix for react-native-html-to-pdf codegen spec header
        if target.name == 'HtmlToPdf'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/../build/generated/ios"'
        end

        # react-native-date-picker 5.0.13 (the latest) imports React headers unqualified
        # ("RCTConvert.h", "RCTView.h", ...). With RN 0.88's prebuilt core those headers live
        # only inside React.framework, so add its Headers directory to the pod's search path.
        if target.name == 'react-native-date-picker'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_XCFRAMEWORKS_BUILD_DIR)/React-Core-prebuilt/React.framework/Headers"'
        end
      end
    end
  end
end
