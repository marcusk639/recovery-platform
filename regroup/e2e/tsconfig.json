{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noEmit": true,
    "strict": true,
    "target": "es2020",
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "scripts"]
}
