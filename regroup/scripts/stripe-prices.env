# =============================================================================
# Regroup — Stripe price IDs
# Copy into functions/.env.local (or deployment config) before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# Legacy price IDs — still referenced in functions/src/api/stripe.ts for
# grandfathered subscribers. Do not remove until legacy billing is fully retired.
# -----------------------------------------------------------------------------
# STRIPE_HOUSE_PRICE_ID and STRIPE_OXFORD_PRICE_ID are deliberately unset: the IDs
# once here (price_1TZqF1…, price_1TZqF2…RuYQlYKoSl) belong to another Stripe
# account, and only the unreachable legacy two-item code reads them (launch plan S3).
STRIPE_GUEST_PRICE_ID="plan_HFkh7QvRnNjMy8"
STRIPE_API_VERSION="2026-01-28.clover"

# -----------------------------------------------------------------------------
# Tier billing — monthly prices (live mode, created 2026-06-20)
# Referenced by SUBSCRIPTION_TIERS in functions/src/config.ts via priceEnvVar.
# -----------------------------------------------------------------------------
STRIPE_PRICE_OXFORD_STANDARD=price_1TkbSeKsstp3aqoPBgJgeNkK
STRIPE_PRICE_OXFORD_PLUS=price_1TkbSfKsstp3aqoPONbJ6Oef
STRIPE_PRICE_OXFORD_NETWORK=price_1TkbSfKsstp3aqoPRM0TYO4k
STRIPE_PRICE_TRAD_STARTER=price_1TkbSgKsstp3aqoPbxh5xWSn
STRIPE_PRICE_TRAD_PROFESSIONAL=price_1TkbSgKsstp3aqoPhELFzjwr
STRIPE_PRICE_TRAD_ENTERPRISE=price_1TkbSgKsstp3aqoPIvsVavSw

# -----------------------------------------------------------------------------
# Tier billing — annual prices (live mode, created 2026-11-22, owner approved)
# Monthly x 10 ("2 months free"), on the same two products as the monthly prices.
# Log: docs/launch-readiness/stripe-live-config-log-2026-11-21.md
# -----------------------------------------------------------------------------
STRIPE_PRICE_TRAD_STARTER_ANNUAL=price_1UeYjFKsstp3aqoPpBAgvcE1
STRIPE_PRICE_TRAD_PROFESSIONAL_ANNUAL=price_1UeYjGKsstp3aqoPROh0Gi5J
STRIPE_PRICE_TRAD_ENTERPRISE_ANNUAL=price_1UeYjGKsstp3aqoPeoGZhm1k
STRIPE_PRICE_OXFORD_STANDARD_ANNUAL=price_1UeYjHKsstp3aqoPaVufbFN9
STRIPE_PRICE_OXFORD_PLUS_ANNUAL=price_1UeYjIKsstp3aqoP9FsbGXOd
STRIPE_PRICE_OXFORD_NETWORK_ANNUAL=price_1UeYjJKsstp3aqoPWvnA26Gu

# -----------------------------------------------------------------------------
# Other config
# -----------------------------------------------------------------------------
TIER_BILLING_ENABLED=true
RECOVERY_API_BASE_URL=https://us-central1-recovery-platform-e6cb3.cloudfunctions.net

# -----------------------------------------------------------------------------
# Production deploy config beyond prices (non-secret). `npm run env:write --
# --project phoenix-cleanhouse` (in functions/) writes this whole file into the
# gitignored functions/.env.phoenix-cleanhouse that `firebase deploy` reads.
# -----------------------------------------------------------------------------
# Stripe Connect return/refresh origin: the /connect Hosting rewrites in
# web/firebase.json. connectBaseUrl() throws without it (util/connectUrls.ts).
CONNECT_BASE_URL=https://regroup-app.com/connect
# Rent fees (util/rentFee.ts), as deployed on 2026-11-11.
RENT_FEE_ACH_CAP_CENTS=300
RENT_FEE_ACH_FLAT_CENTS=200
RENT_FEE_ACH_RATE=0
RENT_FEE_CARD_PLATFORM_RATE=0.0075
RENT_FEE_LEGACY_RATE=0.02
LEGACY_RENT_FEE_HOUSE_IDS=
