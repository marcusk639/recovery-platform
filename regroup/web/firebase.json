{
  "hosting": {
    "public": "dist/sapp/browser",
    "ignore": [
      "firebase.json",
      "**/.!(well-known)",
      "**/node_modules/**",
      "index.html"
    ],
    "rewrites": [
      {
        "source": "/connect/stripe-return",
        "function": {
          "functionId": "stripeConnectReturn",
          "region": "us-central1"
        }
      },
      {
        "source": "/connect/stripe-refresh",
        "function": {
          "functionId": "stripeConnectReauth",
          "region": "us-central1"
        }
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "destination": "/app-links/apple-app-site-association.json"
      },
      {
        "source": "/apple-app-site-association",
        "destination": "/app-links/apple-app-site-association.json"
      },
      {
        "source": "/.well-known/assetlinks.json",
        "destination": "/app-links/assetlinks.json"
      },
      {
        "source": "**",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      }
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/verify-ssr-target.js\" --expect \"$GCLOUD_PROJECT\" --root \"$PROJECT_DIR/dist/sapp/browser\" --root \"$PROJECT_DIR/functions/dist/sapp/browser\" --root \"$PROJECT_DIR/functions/dist/sapp/server\" --identical \"$PROJECT_DIR/dist/sapp/browser/index.html\" \"$PROJECT_DIR/functions/dist/sapp/browser/index.html\"",
      "node \"$PROJECT_DIR/scripts/verify-app-links.mjs\" --project \"$GCLOUD_PROJECT\" --root \"$PROJECT_DIR/dist/sapp/browser\" --root \"$PROJECT_DIR/functions/dist/sapp/browser\""
    ],
    "headers": [
      {
        "source": "/app-links/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "web",
      "ignore": [
        "node_modules",
        ".git",
        "dist/sapp/browser/*.map",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/verify-ssr-target.js\" --expect \"$GCLOUD_PROJECT\" --root \"$PROJECT_DIR/dist/sapp/browser\" --root \"$PROJECT_DIR/functions/dist/sapp/browser\" --root \"$PROJECT_DIR/functions/dist/sapp/server\" --identical \"$PROJECT_DIR/dist/sapp/browser/index.html\" \"$PROJECT_DIR/functions/dist/sapp/browser/index.html\""
      ]
    }
  ]
}
