{
  "hosting": {
    "public": "dist/sapp/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "index.html"
    ],
    "rewrites": [
      {
        "source": "/connect/stripe-return",
        "function": {
          "functionId": "stripeConnectReturn",
          "region": "us-central1"
        }
      },
      {
        "source": "/connect/stripe-refresh",
        "function": {
          "functionId": "stripeConnectReauth",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      }
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/verify-ssr-target.js\" --expect \"$GCLOUD_PROJECT\" --root \"$PROJECT_DIR/dist/sapp/browser\" --root \"$PROJECT_DIR/functions/dist/sapp/server\""
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "web",
      "ignore": [
        "node_modules",
        ".git",
        "dist/sapp/browser/*.map",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/verify-ssr-target.js\" --expect \"$GCLOUD_PROJECT\" --root \"$PROJECT_DIR/dist/sapp/browser\" --root \"$PROJECT_DIR/functions/dist/sapp/server\""
      ]
    }
  ]
}
