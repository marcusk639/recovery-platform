{
  "name": "sapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "export NODE_OPTIONS=--openssl-legacy-provider; ng serve --host 0.0.0.0",
    "test": "export NODE_OPTIONS=--openssl-legacy-provider; ng test",
    "lint": "export NODE_OPTIONS=--openssl-legacy-provider; ng lint",
    "e2e": "export NODE_OPTIONS=--openssl-legacy-provider; ng e2e",
    "dev:ssr": "export NODE_OPTIONS=--openssl-legacy-provider; ng run sapp:serve-ssr",
    "serve:ssr": "node dist/sapp/server/main.js",
    "build:ssr": "export NODE_OPTIONS=--openssl-legacy-provider; ng build --prod && ng run sapp:server:production",
    "prerender": "ng run sapp:prerender",
    "build": "export NODE_OPTIONS=--openssl-legacy-provider; npm run build:ssr && npm run build:functions",
    "build:functions": "npm run --prefix functions build",
    "deploy": "firebase deploy --only hosting,functions:web:ssr",
    "build:deploy": "npm run build && npm run deploy"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~9.1.0",
    "@angular/common": "~9.1.0",
    "@angular/compiler": "~9.1.0",
    "@angular/core": "~9.1.0",
    "@angular/fire": "^6.0.0",
    "@angular/forms": "~9.1.0",
    "@angular/platform-browser": "~9.1.0",
    "@angular/platform-browser-dynamic": "~9.1.0",
    "@angular/platform-server": "~9.1.0",
    "@angular/router": "~9.1.0",
    "@nguniversal/express-engine": "^9.1.1",
    "@nguniversal/module-map-ngfactory-loader": "^8.2.6",
    "@stripe/stripe-js": "^1.5.0",
    "domino": "^2.1.5",
    "express": "^4.17.1",
    "firebase": "^7.14.2",
    "moment": "^2.25.3",
    "ngx-stripe": "^9.0.2",
    "rxjs": "~6.5.4",
    "stripe": "^8.49.0",
    "ts-loader": "^7.0.4",
    "tslib": "^1.10.0",
    "webpack-cli": "^3.3.11",
    "yup": "^0.28.5",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/architect": "~0.900",
    "@angular-devkit/build-angular": "~0.901.0",
    "@angular/cli": "~9.1.0",
    "@angular/compiler-cli": "~9.1.0",
    "@angular/language-service": "~9.1.0",
    "@nguniversal/builders": "^9.1.1",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~3.5.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/lodash": "^4.14.150",
    "@types/node": "^12.11.1",
    "bufferutil": "^4.0.1",
    "codelyzer": "^5.1.2",
    "firebase-tools": "^8.0.0",
    "fuzzy": "^0.1.3",
    "inquirer": "^6.2.2",
    "inquirer-autocomplete-prompt": "^1.0.1",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~4.4.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~2.1.0",
    "karma-jasmine": "~3.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "protractor": "~5.4.3",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~3.8.3",
    "utf-8-validate": "^5.0.2",
    "ws": "^7.3.0",
    "xhr2": "^0.2.0"
  }
}
