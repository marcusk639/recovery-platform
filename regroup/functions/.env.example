# Regroup Cloud Functions — environment & secret manifest
#
# This file documents EVERY env var / secret the functions read. Copy to `.env`
# for local/emulator use (`.env` is gitignored). In production, SECRETS go in
# Firebase Secret Manager (`firebase functions:secrets:set NAME`) and the plain
# config values below are set as deploy-time environment variables.
#
# Two kinds of values:
#   [SECRET] — Firebase Secret Manager (firebase functions:secrets:set NAME)
#   [CONFIG] — plain process.env (non-secret deploy config)

# ─── Secrets (Firebase Secret Manager) ──────────────────────────────────────
SENDGRID_API_KEY=                 # [SECRET] SendGrid transactional email
STRIPE_SECRET_KEY=                # [SECRET] Stripe secret/restricted key (sk_/rk_)
STRIPE_CLIENT_ID=                 # [SECRET] Stripe Connect client id (ca_...)
STRIPE_WEBHOOK_SECRET=            # [SECRET] Stripe webhook signing secret (whsec_...)
STRIPE_CONNECT_WEBHOOK_SECRET=    # [SECRET] Stripe Connect webhook signing secret (whsec_...)
RATS_API_KEY=                     # [SECRET] Bearer for RATS -> legacy HTTP calls
GOOGLE_MAPS_API_KEY=              # [SECRET] Google Maps Platform (Geocoding, Time Zone)
RECOVERY_PLATFORM_API_KEY=        # [SECRET] Service key for server-to-server recovery-api calls

# ─── Stripe API version ─────────────────────────────────────────────────────
# Pin explicitly — unset silently defaults the api/stripe.ts client.
STRIPE_API_VERSION=2026-01-28.clover  # [CONFIG]

# ─── Tier billing toggle ────────────────────────────────────────────────────
TIER_BILLING_ENABLED=true         # [CONFIG] "true" enables the 6-tier flat-fee model

# ─── Tier price IDs — monthly (6) ───────────────────────────────────────────
# Stripe Price IDs (price_...). Resolved at runtime by env name (never hardcoded).
STRIPE_PRICE_TRAD_STARTER=        # [CONFIG] Traditional Starter      ($69/mo)
STRIPE_PRICE_TRAD_PROFESSIONAL=   # [CONFIG] Traditional Professional ($129/mo)
STRIPE_PRICE_TRAD_ENTERPRISE=     # [CONFIG] Traditional Enterprise   ($249/mo)
STRIPE_PRICE_OXFORD_STANDARD=     # [CONFIG] Oxford Standard          ($49/mo)
STRIPE_PRICE_OXFORD_PLUS=         # [CONFIG] Oxford Plus              ($89/mo)
STRIPE_PRICE_OXFORD_NETWORK=      # [CONFIG] Oxford Network ($299/mo) — not for sale (P-8)

# ─── Tier price IDs — annual (6) ────────────────────────────────────────────
# ~17% off (2 months free), per P-4. e.g. $49/mo -> $490/yr; $129/mo -> $1,290/yr.
STRIPE_PRICE_TRAD_STARTER_ANNUAL=      # [CONFIG]
STRIPE_PRICE_TRAD_PROFESSIONAL_ANNUAL= # [CONFIG]
STRIPE_PRICE_TRAD_ENTERPRISE_ANNUAL=   # [CONFIG]
STRIPE_PRICE_OXFORD_STANDARD_ANNUAL=   # [CONFIG]
STRIPE_PRICE_OXFORD_PLUS_ANNUAL=       # [CONFIG]
STRIPE_PRICE_OXFORD_NETWORK_ANNUAL=    # [CONFIG]

# ─── Legacy price IDs (existing subscribers only) ───────────────────────────
STRIPE_HOUSE_PRICE_ID=            # [CONFIG] Legacy per-house price
STRIPE_GUEST_PRICE_ID=            # [CONFIG] Legacy per-guest price
STRIPE_OXFORD_PRICE_ID=           # [CONFIG] Legacy Oxford per-house price

# ─── Rent application-fee model (P-1/P-2/P-3) ───────────────────────────────
# Integer cents / decimal rates. Defaults shown; override to tune.
RENT_FEE_ACH_FLAT_CENTS=200       # [CONFIG] ACH flat fee, $2.00 (used when ACH_RATE=0)
RENT_FEE_ACH_RATE=0               # [CONFIG] ACH percentage (0 = use the flat fee)
RENT_FEE_ACH_CAP_CENTS=300        # [CONFIG] ACH percentage cap, $3.00
RENT_FEE_CARD_PLATFORM_RATE=0.0075 # [CONFIG] Card platform fee, 0.75%
RENT_FEE_LEGACY_RATE=0.02         # [CONFIG] Legacy grandfathered rate, 2%
LEGACY_RENT_FEE_HOUSE_IDS=        # [CONFIG] Comma-separated house IDs grandfathered at 2%

# ─── Cross-product integration ──────────────────────────────────────────────
RECOVERY_API_BASE_URL=            # [CONFIG] recovery-api base URL (shared meeting directory)
