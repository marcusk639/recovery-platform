{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noEmitOnError": true,
    "noEmit": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "typeRoots": [
      "node_modules/@types"
    ],
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "linterOptions": {
    "exclude": [
        "bin",
        "src/util/create-demo.ts"
    ]
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}