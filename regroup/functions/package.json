{
  "name": "functions",
  "scripts": {
    "lint": "./node_modules/.bin/tslint -p tslint.json",
    "build": "./node_modules/.bin/tsc",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:batched": "bash ../scripts/deploy-batched.sh",
    "logs": "firebase functions:log",
    "migrate:dry-run": "npm run build && node lib/scripts/migrateGuestWeeks.js --dry-run",
    "migrate:run": "npm run build && node lib/scripts/migrateGuestWeeks.js",
    "migrate:house-sub:dry-run": "npm run build && node lib/scripts/migrateHouseSubscriptionStatus.js --dry-run",
    "migrate:house-sub:run": "npm run build && node lib/scripts/migrateHouseSubscriptionStatus.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@sendgrid/mail": "^7.3.0",
    "@types/ngeohash": "^0.6.8",
    "axios": "^0.19.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.2.5",
    "haversine-distance": "^1.1.4",
    "lodash": "^4.17.15",
    "moment": "^2.24.0",
    "ngeohash": "^0.6.3",
    "nodemailer": "^6.3.0",
    "pdfkit": "^0.19.1",
    "robust-point-in-polygon": "^1.0.3",
    "stripe": "^20.3.1",
    "tabletojson": "git+https://git@github.com/mklein530/tabletojson.git",
    "unique-names-generator": "^4.2.0",
    "uuid": "^8.0.0",
    "x-ray": "^2.3.4",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/pdfkit": "^0.17.6",
    "@types/xml2js": "^0.4.13",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tslint": "^6.1.3",
    "typescript": "^5.1.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts",
      "!src/entities/**",
      "!src/scripts/**"
    ]
  },
  "private": true
}
