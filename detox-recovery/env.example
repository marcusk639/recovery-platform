# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_ vars are safe to expose in the browser.
# All others are server-only.
# Run: npm run setup:env  (pre-fills Stripe URLs automatically)
# ─────────────────────────────────────────────

# Resend — contact form email delivery (https://resend.com/api-keys)
RESEND_API_KEY=re_REPLACE
RESEND_TO_EMAIL=your@email.com
# Verified sender address in Resend — must match a domain added in resend.com/domains
RESEND_FROM_EMAIL=Withdrawal Support <you@yourdomain.com>

# MailerLite — newsletter + lead magnet subscribers (https://app.mailerlite.com → Integrations → API)
MAILERLITE_API_KEY=REPLACE
MAILERLITE_GROUP_ID_NEWSLETTER=REPLACE
MAILERLITE_GROUP_ID_LEAD_MAGNET_UNSAFE=REPLACE
MAILERLITE_GROUP_ID_LEAD_MAGNET_FAMILY=REPLACE
MAILERLITE_GROUP_ID_B2B=REPLACE

# Calendly — booking links (copy event URL from your Calendly dashboard)
NEXT_PUBLIC_CALENDLY_FIT_CHECK_URL=https://calendly.com/YOUR_NAME/free-10-minute-fit-check
NEXT_PUBLIC_CALENDLY_SUPPORT_CALL_URL=https://calendly.com/YOUR_NAME/30-minute-withdrawal-support-call

# Stripe Payment Links — copy from Stripe dashboard → Payment Links
# (pre-filled automatically by: npm run setup:env)
NEXT_PUBLIC_STRIPE_SUPPORT_CALL_URL=https://buy.stripe.com/REPLACE
# Lemon Squeezy — paid PDF products (copy buy links from lemonsqueezy.com dashboard)
NEXT_PUBLIC_LEMONSQUEEZY_FAMILY_GUIDE_URL=https://nextsteprecovery.lemonsqueezy.com/buy/REPLACE
NEXT_PUBLIC_LEMONSQUEEZY_APPOINTMENT_PREP_URL=https://nextsteprecovery.lemonsqueezy.com/buy/REPLACE
NEXT_PUBLIC_LEMONSQUEEZY_SAFETY_CHECKLIST_URL=https://nextsteprecovery.lemonsqueezy.com/buy/REPLACE
NEXT_PUBLIC_LEMONSQUEEZY_TREATMENT_COMPARISON_URL=https://nextsteprecovery.lemonsqueezy.com/buy/REPLACE
NEXT_PUBLIC_LEMONSQUEEZY_RELAPSE_PREVENTION_URL=https://nextsteprecovery.lemonsqueezy.com/buy/REPLACE
NEXT_PUBLIC_STRIPE_DONATION_URL=https://buy.stripe.com/REPLACE

# recovery-api — optional, enables partner referrals
# Local dev: http://localhost:8080 | Production: deployed recovery-api URL
RECOVERY_API_URL=http://localhost:8080
# Sent as X-Service-Key; must match recovery-api's RECOVERY_PLATFORM_API_KEY secret (generate: openssl rand -hex 32)
RECOVERY_API_KEY=
