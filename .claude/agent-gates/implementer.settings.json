{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/agent-gates/guard.sh",
            "timeout": 10,
            "statusMessage": "agent-gates: checking edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/agent-gates/guard.sh",
            "timeout": 10,
            "statusMessage": "agent-gates: checking command"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/agent-gates/guard.sh",
            "timeout": 10,
            "statusMessage": "agent-gates: post-write check"
          }
        ]
      }
    ]
  }
}
