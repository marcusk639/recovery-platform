{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run test)",
      "Bash(npm run test -- *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:ratchet)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit -p *)",
      "Bash(npx prettier --check *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(git checkout -- .)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * +*)",
      "Bash(git -C * push *--no-verify*)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean -*f*)",
      "Bash(git -C * checkout -- .)",
      "Bash(git -C * checkout .)",
      "Bash(git -C * restore .)",
      "Bash(chmod -R 777 *)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(npm publish*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if echo \"$FILE\" | grep -q '/recovery-api/src/'; then echo \"[tsc] Type-checking recovery-api...\"; cd \"${CLAUDE_PROJECT_DIR}/recovery-api\" && npm run typecheck 2>&1 | tail -30; fi",
            "timeout": 45000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if echo \"$FILE\" | grep -qE '\\.(ts|js|json|md)$' && echo \"$FILE\" | grep -q '/recovery-api/'; then cd /Users/marcusklein/dev/recovery-platform/recovery-api && npx prettier --write \"$FILE\" 2>/dev/null && echo \"[prettier] Formatted $FILE\"; fi",
            "timeout": 15000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/marcusklein/dev/recovery-platform}/.claude/hooks/secret-scan.sh\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/marcusklein/dev/recovery-platform}/scripts/session-check.sh\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/marcusklein/dev/recovery-platform}/.claude/hooks/swarm-notify.sh\"",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
