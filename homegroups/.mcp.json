{
  "mcpServers": {
    "detox": {
      "command": "npx",
      "args": ["detox-mcp"],
      "env": {
        "DETOX_PROJECT_PATH": "${CLAUDE_PROJECT_DIR}/mobile"
      }
    },
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-tools", "mcp", "--dir", "${CLAUDE_PROJECT_DIR}"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@3.0.0"]
    }
  }
}
