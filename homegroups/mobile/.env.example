# Homegroups mobile environment template — copy to .env (never commit .env).
# Variables are consumed via react-native-dotenv (`@env` module, typed in env.d.ts).

GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Publishable key ONLY — no Stripe secret/restricted key ever belongs in a mobile bundle.
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your-publishable-key
