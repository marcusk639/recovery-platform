{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/tests/**",
    "!src/**/__tests__/**",
    "!src/index.ts",
    "!src/utils/reflectionsLibrary.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 28
  },
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "concurrency": 14,
  "timeoutMS": 60000,
  "disableTypeChecks": true,
  "clearTextReporter": {
    "maxTestsToLog": 0,
    "allowColor": false
  }
}
