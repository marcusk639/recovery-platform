{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && npm test -- --passWithNoTests && firebase deploy --only functions",
    "deploy:batch": "npm run build && npm test -- --passWithNoTests && bash ../scripts/deploy-functions.sh",
    "deploy:batch:dry": "npm run build && bash ../scripts/deploy-functions.sh --dry-run",
    "deploy:list": "bash ../scripts/deploy-functions.sh --list",
    "deploy:changed": "npm run build && npm test -- --passWithNoTests && bash ../scripts/deploy-functions.sh --changed",
    "deploy:from": "npm run build && bash ../scripts/deploy-functions.sh --from",
    "logs": "firebase functions:log",
    "test": "jest --detectOpenHandles",
    "test:rules": "firebase emulators:exec --only firestore 'npm run test'"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/storage": "^7.7.0",
    "@sendgrid/mail": "^8.1.5",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "fuzzball": "^2.2.2",
    "geofire-common": "^6.0.0",
    "haversine-distance": "^1.2.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "ngeohash": "^0.6.3",
    "pdfkit": "^0.15.2",
    "robust-point-in-polygon": "^1.0.3",
    "stripe": "~20.2.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.12",
    "@types/moment-timezone": "^0.5.30",
    "@types/ngeohash": "^0.6.8",
    "@types/pdfkit": "^0.13.4",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^4.5.4"
  },
  "private": true
}
