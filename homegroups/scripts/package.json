{
  "name": "recovery-connect-scripts",
  "version": "1.0.0",
  "description": "Scripts for testing and managing Homegroups app",
  "main": "index.js",
  "scripts": {
    "test-chat": "ts-node testChatFunctionality.ts",
    "reset-metro": "sh reset-metro.sh",
    "cleanup-revisions": "sh cleanup-cloud-run-revisions.sh",
    "deploy:all": "bash deploy-functions.sh",
    "deploy:list": "bash deploy-functions.sh --list",
    "deploy:dry-run": "bash deploy-functions.sh --dry-run",
    "deploy:security": "bash deploy-functions.sh --only onMemberWrite,onGroupTreasurerUpdate,syncUserClaims",
    "migrate:claims": "ts-node migrateClaimsAndRoles.ts",
    "migrate:claims:dry": "ts-node migrateClaimsAndRoles.ts --dry-run --verbose",
    "users:view": "ts-node viewAndCleanupUsers.ts --verbose",
    "users:cleanup": "ts-node viewAndCleanupUsers.ts --cleanup",
    "users:cleanup:dry": "ts-node viewAndCleanupUsers.ts --cleanup --dry-run"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "commander": "^13.1.0",
    "firebase-admin": "^11.5.0",
    "geofire-common": "^6.0.0",
    "moment-timezone": "^0.5.43",
    "ngeohash": "^0.6.3",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}
